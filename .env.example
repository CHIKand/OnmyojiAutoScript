# 复制为 .env 后按需填写；.env 不进 git
# 请保存为 UTF-8；注释必须单独占一行，写在值后面的行尾注释会变成值的一部分
# 1 = 菜单显示全部任务；缺省或其他值 = 只显示定制菜单
# 修改并保存后，需关闭并重新打开 OASX 才生效（OASX 只在启动时拉取一次菜单）
OAS_MENU_SHOW_ALL=0
# 上游（社区仓库）的地址和分支：OASX 更新页的检查更新、合并上游都用它们；缺省或留空就是下面这两个值
# 每次检查更新或合并时重新读取，修改并保存后不用重启服务
OAS_UPSTREAM_URL=https://gitcode.com/OnmyojiAutoScript/OnmyojiAutoScript.git
OAS_UPSTREAM_BRANCH=dev
# 每日定时合并上游的时间，格式 HH:MM（24 小时制）；缺省 = 关闭定时合并，下面这行默认注释着
# 想开启就去掉行首的 # 并改成想要的时间，建议放在防封禁休眠窗口内（合并成功后会重启运行中的实例）
# 错过了这个时间（电脑休眠、服务没开）会在下一次检查时补跑，服务启动时会立刻检查一次，所以可能在白天补跑，补跑同样会重启运行中的实例
# 一天最多合并一次；只有拉取失败（断网等）不算这一次，10 分钟后重试，一天最多试 6 次
# 修改并保存后即生效，不用重启服务
# 先别开启：等在运行目录里有人值守、确认第一次推送到 fork 成功之后再开
# OAS_UPSTREAM_MERGE_TIME=03:30
# 飞书推送（报错时由飞书自建应用的机器人发消息）：下面两个值在飞书开发者后台 https://open.feishu.cn/app 进入应用，
# 打开"基础信息 > 凭证与基础信息"，在"应用凭证"区域复制 App ID 和 App Secret；只写在这里，不要写进推送配置
# 应用还要准备好下面三件事，否则发不出去：
# 1. 打开"开发配置 > 权限管理"，点"开通权限"，开通这三项：im:message:send_as_bot（以应用的身份发消息）、
#    im:resource（获取与上传图片或文件资源）、im:chat:readonly（获取群组信息）
# 2. 点"添加应用能力"，添加"机器人"
# 3. 打开"应用发布 > 版本管理与发布"，创建版本并申请线上发布，"可用范围"要包含接收消息的人；企业管理员审核通过后才生效
#    以后改了权限、应用能力或可用范围，都要重新发布版本
# 然后在 OASX 里打开实例的"脚本 → 出错设置"，勾选"启用消息推送"，"消息推送配置"写成下面四行（去掉行首的 # 和空格）：
#   provider: feishu_app
#   receive_id_type: open_id   # 发给个人写 open_id，发到群写 chat_id
#   receive_id: ou_xxx         # 个人的 open_id（ou_ 开头），或群的 chat_id（oc_ 开头）
#   aggregate_minutes: 10      # 同类错误合并的分钟数，可省略，缺省 10；写 0 就不合并
# 每次发送时重新读取，修改并保存后不用重启服务
FEISHU_APP_ID=
FEISHU_APP_SECRET=
